{
  "name": "@evtivity/octt",
  "version": "0.1.42",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "test": "vitest run",
    "run:all": "tsx src/cli.ts --server ws://localhost:7103",
    "run:1.6": "tsx src/cli.ts --server ws://localhost:7103 --version ocpp1.6",
    "run:2.1": "tsx src/cli.ts --server ws://localhost:7103 --version ocpp2.1",
    "run:cs": "tsx src/cs-cli.ts",
    "run:cs:2.1": "tsx src/cs-cli.ts --version ocpp2.1",
    "run:cs:1.6": "tsx src/cs-cli.ts --version ocpp1.6"
  },
  "dependencies": {
    "@evtivity/css": "*",
    "@evtivity/database": "*",
    "@evtivity/lib": "*",
    "@evtivity/v2g-exi": "*",
    "@peculiar/asn1-ocsp": "^2.10.0",
    "@peculiar/asn1-schema": "^2.10.0",
    "@peculiar/asn1-x509": "^2.10.0",
    "@peculiar/x509": "^2.1.0",
    "argon2": "^0.44.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.5",
    "reflect-metadata": "^0.2.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
