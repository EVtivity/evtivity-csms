{{#if firstName}}<p style='color:#4b5563;line-height:1.6;margin:0 0 16px 0;'>Hi {{firstName}},</p>{{/if}}
{{#if billedTo}}<p style='color:#4b5563;line-height:1.6;margin:0 0 16px 0;'>Your charging sessions are now billed to <strong>{{billedTo}}</strong>. No card is charged for them.</p>{{else}}<p style='color:#4b5563;line-height:1.6;margin:0 0 16px 0;'>Your charging sessions are no longer billed to <strong>{{fleetName}}</strong>. Your saved payment method pays for them.</p>{{/if}}
<p style='color:#6b7280;line-height:1.6;margin:0;font-size:14px;'>Questions about your billing? Contact your fleet manager or support.</p>
