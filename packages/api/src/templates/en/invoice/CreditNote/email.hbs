<h2 style='color:#1a1a1a;margin:0 0 16px 0;'>Credit note {{creditNoteNumber}}</h2>
<p style='color:#4b5563;line-height:1.6;margin:0 0 16px 0;'>Hi {{firstName}},</p>
<p style='color:#4b5563;line-height:1.6;margin:0 0 16px 0;'>{{companyName}} issued a credit note that cancels invoice {{invoiceNumber}} in full.</p>
<table style='width:100%;border-collapse:collapse;margin:0 0 16px 0;'>
  <tr><td style='padding:6px 0;color:#6b7280;'>Credit note</td><td style='padding:6px 0;color:#1a1a1a;text-align:right;'>{{creditNoteNumber}}</td></tr>
  <tr><td style='padding:6px 0;color:#6b7280;'>Invoice</td><td style='padding:6px 0;color:#1a1a1a;text-align:right;'>{{invoiceNumber}}</td></tr>
  <tr><td style='padding:6px 0;color:#6b7280;'>Issued</td><td style='padding:6px 0;color:#1a1a1a;text-align:right;'>{{issuedAt}}</td></tr>
  <tr><td style='padding:6px 0;color:#6b7280;'>Reason</td><td style='padding:6px 0;color:#1a1a1a;text-align:right;'>{{creditReason}}</td></tr>
  <tr><td style='padding:6px 0;color:#1a1a1a;'><strong>Amount credited</strong></td><td style='padding:6px 0;color:#1a1a1a;text-align:right;'><strong>{{total}}</strong></td></tr>
</table>
{{#if wasPaid}}<p style='color:#4b5563;line-height:1.6;margin:0 0 16px 0;'>You already paid this invoice. The amount is refunded to you separately.</p>{{/if}}
