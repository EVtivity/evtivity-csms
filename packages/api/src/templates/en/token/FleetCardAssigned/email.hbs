{{#if firstName}}<p style='color:#4b5563;line-height:1.6;margin:0 0 16px 0;'>Hi {{firstName}},</p>{{/if}}
<p style='color:#4b5563;line-height:1.6;margin:0 0 16px 0;'>Your fleet <strong>{{fleetName}}</strong> gave you an RFID card:</p>
<p style='color:#1a1a1a;line-height:1.6;margin:0 0 16px 0;'><strong>{{idToken}}</strong> ({{tokenType}})</p>
{{#if label}}<p style='color:#4b5563;line-height:1.6;margin:0 0 16px 0;'>Label: {{label}}</p>{{/if}}
<p style='color:#6b7280;line-height:1.6;margin:0;font-size:14px;'>Sessions you start with this card are billed to the fleet. Ask your fleet manager if you have questions.</p>
