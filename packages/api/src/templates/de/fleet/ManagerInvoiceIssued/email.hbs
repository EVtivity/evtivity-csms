<h2 style='color:#1a1a1a;margin:0 0 16px 0;'>Rechnung {{invoiceNumber}}</h2>
<p style='color:#4b5563;line-height:1.6;margin:0 0 16px 0;'>{{#if firstName}}Hallo {{firstName}},{{else}}Guten Tag,{{/if}}</p>
<p style='color:#4b5563;line-height:1.6;margin:0 0 16px 0;'>{{companyName}} hat eine neue Rechnung für die Ladevorgänge Ihrer Flotte <strong>{{fleetName}}</strong> im Zeitraum {{periodLabel}} ausgestellt.</p>
<table style='width:100%;border-collapse:collapse;margin:0 0 16px 0;'>
  <tr><td style='padding:6px 0;color:#6b7280;'>Rechnung</td><td style='padding:6px 0;color:#1a1a1a;text-align:right;'>{{invoiceNumber}}</td></tr>
  <tr><td style='padding:6px 0;color:#6b7280;'>Zeitraum</td><td style='padding:6px 0;color:#1a1a1a;text-align:right;'>{{periodLabel}}</td></tr>
  <tr><td style='padding:6px 0;color:#6b7280;'>Ladevorgänge</td><td style='padding:6px 0;color:#1a1a1a;text-align:right;'>{{sessionCount}}</td></tr>
  <tr><td style='padding:6px 0;color:#6b7280;'>Rechnungsdatum</td><td style='padding:6px 0;color:#1a1a1a;text-align:right;'>{{issuedAt}}</td></tr>
  <tr><td style='padding:6px 0;color:#6b7280;'>Fällig am</td><td style='padding:6px 0;color:#1a1a1a;text-align:right;'>{{dueAt}}</td></tr>
  <tr><td style='padding:6px 0;color:#1a1a1a;'><strong>Fälliger Betrag</strong></td><td style='padding:6px 0;color:#1a1a1a;text-align:right;'><strong>{{total}}</strong></td></tr>
</table>
<table cellpadding='0' cellspacing='0' border='0' width='100%' style='border-collapse:collapse;border-spacing:0;'><tr><td align='center' style='padding:24px 0;'><a href='{invoiceUrl}' style='display:inline-block;background-color:#2563eb;color:#ffffff;padding:12px 24px;border-radius:6px;text-decoration:none;font-weight:600;font-size:16px;'>Rechnung ansehen</a></td></tr></table>
