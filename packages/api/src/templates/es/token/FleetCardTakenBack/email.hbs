{{#if firstName}}<p style='color:#4b5563;line-height:1.6;margin:0 0 16px 0;'>Hola {{firstName}},</p>{{/if}}
<p style='color:#4b5563;line-height:1.6;margin:0 0 16px 0;'>Tu flota <strong>{{fleetName}}</strong> ha retirado esta tarjeta RFID:</p>
<p style='color:#1a1a1a;line-height:1.6;margin:0 0 16px 0;'><strong>{{idToken}}</strong> ({{tokenType}})</p>
{{#if label}}<p style='color:#4b5563;line-height:1.6;margin:0 0 16px 0;'>Etiqueta: {{label}}</p>{{/if}}
<p style='color:#6b7280;line-height:1.6;margin:0;font-size:14px;'>Ya no inicia cargas para ti. Si tienes dudas, consulta a tu gestor de flota.</p>
