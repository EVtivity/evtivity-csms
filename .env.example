# Network binding (0.0.0.0 = all interfaces, 127.0.0.1 = localhost only)
# BIND_IP: user-facing ports (CSMS, portal, API, OCPP, OCPP TLS, OCPI).
# BIND_IP=0.0.0.0
# INFRA_BIND_IP: infrastructure and tool ports (postgres, pgadmin, mailpit,
# ftp, prometheus, grafana, loki). They use default logins, so the default is
# 127.0.0.1. Widen only on a trusted network. Redis and the Node inspector
# (9229) always stay on 127.0.0.1.
# INFRA_BIND_IP=127.0.0.1

# Database
DATABASE_URL=postgres://evtivity:evtivity@localhost:5433/evtivity
# Connections each service process pools (api, ocpp, ocpi, worker: default 20;
# simulator: default 10). docker-compose sets api, ocpp and worker to 20, ocpi
# and the simulator to 10; setting it here applies one value to all of them.
# Keep the sum over all processes below the Postgres max_connections (200 in
# docker-compose). The OCPP server runs at most half its pool of station
# connection authentications at once.
# DB_POOL_MAX=20
REGISTRATION_POLICY=approval-required

# Initial seed credentials (created by the migrate container's seed:admin
# and seed:driver steps on first `docker compose up -d`). Override these
# before bringing up the stack in any non-local environment. Idempotent:
# subsequent runs do not overwrite existing rows.
INITIAL_ADMIN_EMAIL=admin@evtivity.local
INITIAL_ADMIN_PASSWORD=admin123
INITIAL_ADMIN_MUST_RESET_PASSWORD=false
INITIAL_DRIVER_EMAIL=driver@evtivity.local
INITIAL_DRIVER_PASSWORD=driver123

# Demo data seeding. Read by `npm run db:seed` (scripts/docker-build.sh runs
# it host-side). true = full demo dataset (sites, stations, sessions,
# drivers), false = admin user and settings only. Also displayed in the
# dashboard System Info dialog via the api service.
SEED_DEMO=false
# Optional overrides for the css_stations target_url written by the demo
# seed, as reachable from the CSS container. Defaults: ws://ocpp:7103 and
# wss://ocpp:8443 (docker-compose service hostnames).
# SEED_CSS_TARGET_URL=
# SEED_CSS_TLS_TARGET_URL=

# Redis
# Processes started on the host (npm run dev:*) connect as the default user,
# which Docker Compose leaves open on 127.0.0.1 only.
REDIS_URL=redis://localhost:6379
# Docker Compose: password of each service's Redis user (docker/redis/acl-rules.conf).
# The dev defaults are used when unset. Set them when the stack runs on a shared host.
# Characters must be URL-safe (they go into each service's REDIS_URL).
# REDIS_API_PASSWORD=
# REDIS_OCPP_PASSWORD=
# REDIS_OCPI_PASSWORD=
# REDIS_WORKER_PASSWORD=
# REDIS_CSS_PASSWORD=
# rediss:// with a private CA (the Helm chart's bundled Redis with TLS on):
# the CA as a PEM string or a path to it. Not used by Docker Compose (plain TCP).
# REDIS_TLS_CA_PEM=
# REDIS_TLS_CA_FILE=

# Ports
CSMS_PORT=7100
PORTAL_PORT=7101

# API Server
API_PORT=7102
API_HOST=0.0.0.0
JWT_SECRET=dev-jwt-secret-change-in-production!!
CORS_ORIGIN=local
SETTINGS_ENCRYPTION_KEY=dev-encryption-key-32chars-long!
# API_BASE_URL=http://localhost:7102

# Payments (API, OCPP and worker)
# Allows the simulated (test) payment provider. Defaults to true when NODE_ENV
# is development or test, false otherwise. Never enable it in production.
PAYMENTS_ALLOW_SIMULATED=true

# Notification test sink (API, OCPP and worker; local development only)
# Sends driver SMS and push to the notify-sink dev tool (tools profile, port
# NOTIFY_SINK_PORT, default 7111) instead of Twilio and Expo. Off unless both
# are set, and only with NODE_ENV development or test (the Compose services
# set development). Any other NODE_ENV, unset included, the Helm chart and the
# CDK refuse it. docker-compose.yml leaves it off; scripts/docker-build.sh
# turns it on when you pick the dev tools (tools profile), and
# scripts/docker-restart.sh keeps it on while notify-sink runs. Set
# NOTIFICATIONS_TEST_SINK_URL= (empty) here to keep Twilio and Expo with the
# tools. Inside Compose the sink URL is http://notify-sink:8080.
# NOTIFICATIONS_ALLOW_TEST_SINK=true
# NOTIFICATIONS_TEST_SINK_URL=http://notify-sink:8080
# NOTIFY_SINK_PORT=7111

# OCPP Server
OCPP_PORT=7103
OCPP_HOST=0.0.0.0
OCPP_MAX_CONNECTIONS_PER_IP=2500
OCPP_MAX_MESSAGES_PER_IP_PER_SECOND=5000
# Comma-separated CIDRs of load balancers whose X-Forwarded-For header is trusted for the station IP.
# OCPP_TRUSTED_PROXY_CIDRS=
# Station connection authentications after a reconnect wave: how many run at once
# (default half of DB_POOL_MAX), how many wait (1000), and the longest wait in ms
# (10000). Over the queue or the wait the station gets 503 with Retry-After.
# OCPP_AUTH_MAX_CONCURRENT=10
# OCPP_AUTH_MAX_QUEUED=1000
# OCPP_AUTH_MAX_WAIT_MS=10000

# OCPP_HEALTH_PORT=8081

# OCPP TLS (Security Profile 2/3)
# OCPP_TLS_CERT=/path/to/cert.pem
# OCPP_TLS_KEY=/path/to/key.pem
# OCPP_TLS_CA=/path/to/ca.pem
# OCPP_TLS_PORT=8443
# Public wss:// address stations use for security profiles 2 and 3 (no station ID).
# Used by the API to move a connected OCPP 2.1 station from plain WebSocket to TLS.
# OCPP_STATION_TLS_URL=wss://ocpp.example.com

# OCPI Server
OCPI_PORT=7104
OCPI_HOST=0.0.0.0
OCPI_BASE_URL=http://localhost:7104
OCPI_COUNTRY_CODE=US
OCPI_PARTY_ID=EVT
OCPI_BUSINESS_NAME=EVtivity

# OCPI Simulator (eMSP)
OCPI_SIM_PORT=7105
OCPI_SIM_HOST=0.0.0.0
OCPI_SIM_BASE_URL=http://localhost:7105
OCPI_SIM_ROLE=emsp
OCPI_SIM_COUNTRY_CODE=NL
OCPI_SIM_PARTY_ID=SIM
OCPI_SIM_NAME="OCPI Simulator"
# Set these to auto-register on startup (token must match a seeded or API-created partner)
OCPI_TARGET_URL=http://localhost:7104
OCPI_REGISTRATION_TOKEN=ocpi-sim-reg-token
# Optional: restrict inbound registration to a specific token
# OCPI_SIM_INCOMING_REG_TOKEN=

# CSS (Charging Station Simulator)
CSS_MODE=standby
CSS_HEALTH_PORT=8082
CSS_ACTION_INTERVAL_MS=1000
CSS_STATION_LIMIT=0
OCPP_SERVER_URL=ws://localhost:7103
# OCPP_TLS_SERVER_URL=wss://localhost:8443
# Simulators verify the wss:// server certificate unless this is false (dev with self-signed certs)
# TLS_REJECT_UNAUTHORIZED=false

# OCTT conformance runs from the dashboard (worker): the URL at which the OCPP
# server reaches the Test System OCSP responder the worker starts during a run
# (it listens on that port). Unset: TC_C_50/51/52 and TC_M_24 are skipped.
# docker-compose sets http://worker:7110/ocsp.
# OCTT_OCSP_RESPONDER_URL=http://localhost:7110/ocsp

# Integrations (Stripe, S3, SMTP, Twilio, reCAPTCHA, Google Maps, Hubject) are
# configured in the dashboard Settings page and stored encrypted in the
# database, including the Stripe webhook signing secret. One env var remains:
# SMTP_HOST=localhost  (overrides the smtp.host DB setting when set)

# Metrics (Prometheus)
# METRICS_PORT=9091

# Rate Limiting
# RATE_LIMIT_MAX=3000
# RATE_LIMIT_WINDOW=1 minute
# AUTH_RATE_LIMIT_MAX=30
# AUTH_RATE_LIMIT_WINDOW=1 minute

# Logging
LOG_LEVEL=info
NODE_ENV=development

# Dev auto-login (skips login page, set to user email). Disabled by default.
# VITE_CSMS_AUTO_LOGIN=admin@evtivity.local
# VITE_PORTAL_AUTO_LOGIN=driver@evtivity.local
